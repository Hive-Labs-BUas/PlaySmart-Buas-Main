# Copy to .env (same folder as pyproject.toml). .env is gitignored; never commit it.
# src/session.py loads this file at import, so every recorder and the uploader see it.

# SFTP upload target on queenbee (BUas network or FortiClient VPN only)
PLAYSMART_SFTP_HOST=10.4.28.2
PLAYSMART_SFTP_PORT=2422
PLAYSMART_SFTP_USER=localhost
PLAYSMART_SFTP_PASSWORD=
# What happens to the session's files after the game (server/python_app/sftp_upload.py):
#   keep = upload and keep the local copy (default)   off = never upload   move = upload, then delete local
PLAYSMART_UPLOAD=keep
# give up connecting after this long (off the VPN: fails fast, files stay local)
# PLAYSMART_SFTP_TIMEOUT_S=10

# OBS Studio -> Tools -> WebSocket Server Settings -> Show Connect Info
PLAYSMART_OBS_PASSWORD=

# League install folder, only if not C:\Riot Games\League of Legends (lcu.py reads its lockfile)
# PLAYSMART_LEAGUE_DIR=D:\Riot Games\League of Legends
# PLAYSMART_OBS_HOST=127.0.0.1
# PLAYSMART_OBS_PORT=4455

# Which game this rig captures. league (default): the capture starts and stops on League's
# local API and records game state. Anything else (valorant, cs2): F7 starts, F12 stops,
# no game-state stream, everything else the same.
PLAYSMART_GAME=league

# Capture switches (see TESTING.md). Comments go on their OWN line: a '# ...' after a
# value becomes part of the value (PLAYSMART_SKIP=eda   # ring   would skip nothing).
# Recorders to neither start nor expect, comma-separated. Default: eda (ring unverified).
PLAYSMART_SKIP=eda
# The face stream (OpenFace on the webcam): action units, head pose, webcam gaze and eyelid
# aperture; no emotion label, no face image or video. OFF unless this line says 1. It is a
# measurement of a person's face, so switch it on only for players whose consent covers it
# (the desktop app has the same switch under "Before you play"). Since 2026-11-10 it needs
# a webcam and OpenFace, not the eye tracker, so it also works on a rig without a Tobii.
# `face` or `emotion` in PLAYSMART_SKIP still switches it off.
PLAYSMART_FACE=0
# FeatureExtraction.exe, if OpenFace_2.2.0_win_x64 is not next to (or one folder above) the rig
# PLAYSMART_OPENFACE_EXE=C:\OpenFace_2.2.0_win_x64\FeatureExtraction.exe
# the Valorant-era full-screen gaze overlay instead of the window-less face recorder
# PLAYSMART_OVERLAY=1
# no post-game dialog asking the player about their deaths
# PLAYSMART_SELF_LABELS=0
# how long to wait for the client's post-game stats block
# PLAYSMART_EOG_WAIT_S=45
# overlay without webcam/OpenFace
# PLAYSMART_OPENFACE=0
# webcam size for OpenFace (default 640x480; 1280x720 gives better AUs, costs CPU)
# PLAYSMART_FACE_CAM=640x480
# PLAYSMART_FACE_DEVICE=0
# also keep the 56 eye-region landmarks (2D+3D) in the face CSV; off by default
# PLAYSMART_FACE_KEEP_LANDMARKS=0
# inline Whisper after the recording (needs the transcription group)
# PLAYSMART_TRANSCRIBE=1
# no video
# PLAYSMART_OBS=0
# the recorder sets OBS up itself before every recording (PlaySmart scene, only the game's
# sound, OBS started when it is closed); 0 = leave an OBS that is set up by hand alone
# PLAYSMART_OBS_SETUP=0
# microphone NOT on recording track 2 (voice only in the rig's own WAV)
# PLAYSMART_OBS_MIC_TRACK=0
# do NOT resize OBS's canvas to the screen before each recording (2026-11-10: it follows the screen)
# PLAYSMART_OBS_FIT=0
# do NOT write the game sound as its own WAV (data/gameaudio) after the game
# PLAYSMART_GAME_AUDIO=off
# ffmpeg for that step, when imageio-ffmpeg is not installed and ffmpeg is not on PATH
# PLAYSMART_FFMPEG=C:\ffmpeg\bin\ffmpeg.exe
# PLAYSMART_DATA_DIR=data

# Staying out of the game's way (2026-11-10; see CHANGELOG and TESTING T14).
# The key that aborts a running capture: f12 (default), f1..f12, or off. F12 is also
# League's screenshot key: with the default, a screenshot ends the recording. The desktop
# app starts the rig with off (a capture then ends with the game, or with Quit).
# PLAYSMART_ABORT_KEY=off
# OpenFace next to the game: how many logical processors it may use (default: a quarter of
# the machine, 1 to 4; all = no limit), its priority (below | idle | normal), and the
# lighter landmark model (about half the CPU) for a PC that cannot hold 10 frames a second.
# PLAYSMART_FACE_CORES=2
# PLAYSMART_FACE_PRIORITY=below
# PLAYSMART_FACE_MODEL=fast

# Riot Developer API key (Match-V5 timeline validation of replay positions). Dev keys expire daily.
RIOT_API_KEY=
